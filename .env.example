# ResuMate AI Environment Configuration

# Backend API
API_V1_STR=/api
PROJECT_NAME="ResuMate AI"
VERSION=1.0.0

# Database
# Default: Local SQLite database
DATABASE_URL=sqlite:///./resumate.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/resumate_db

# AI Provider Credentials (Optional)
# If provided, enables live generative AI rewriting and custom interview prep.
# If omitted, ResuMate AI uses high-speed, rule-based deterministic transformations with zero data transmission.
GEMINI_API_KEY=
OPENAI_API_KEY=

# File Upload Limits
MAX_FILE_SIZE_MB=10

# Frontend URL for CORS
VITE_API_URL=http://localhost:8000/api
